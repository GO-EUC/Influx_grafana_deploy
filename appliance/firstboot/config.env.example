# Optional fallback overrides read by /usr/local/bin/go-euc-firstboot.sh.
# Console wizard populates this file on first local login.

# Enable daily container image upgrades via systemd timer.
# AUTO_UPGRADE_ENABLED=true

# Values are sourced by root shell scripts: quote anything containing spaces or
# shell characters, e.g. APPLIANCE_LOGIN_PASSWORD='my pass$word'.

# Appliance login (the console wizard sets APPLIANCE_LOGIN_PASSWORD; also the web page login).
# APPLIANCE_LOGIN_USER=goeucadmin
# APPLIANCE_LOGIN_PASSWORD='<choose-a-strong-password>'

# Optional break-glass override (if omitted, a random password is generated per VM
# on first boot and stored in /etc/go-euc/break-glass.env).
# BREAK_GLASS_USER=recovery
# BREAK_GLASS_PASSWORD='<choose-a-strong-password>'

# Optional override for the dashboard bundle used by "Run Full Appliance Update".
# DASHBOARDS_ZIP_URL=https://<storage-account>.blob.core.windows.net/files/Dashboards.zip

# Optional fallback network settings (usually set by the console wizard).
# APPLIANCE_STATIC_IP_CIDR=192.168.1.50/24
# APPLIANCE_NETMASK=255.255.255.0
# APPLIANCE_GATEWAY=192.168.1.1
# APPLIANCE_DNS=1.1.1.1,8.8.8.8

# Service admin overrides (if omitted, random passwords/tokens are generated per VM).
# PORTAINER_ADMIN_USER=admin
# PORTAINER_ADMIN_PASSWORD='<choose-a-strong-password>'
# INFLUX_ADMIN_USER=influxadmin
# INFLUX_ADMIN_PASSWORD='<choose-a-strong-password>'
# INFLUX_ADMIN_ORG=monitoring
# INFLUX_INIT_BUCKET=bootstrap
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD='<choose-a-strong-password>'

# Optional Let's Encrypt integration for nginx HTTPS cert replacement.
# Domain must resolve publicly to the appliance for HTTP challenge validation.
# APPLIANCE_LETSENCRYPT_DOMAIN=appliance.example.com
# APPLIANCE_LETSENCRYPT_EMAIL=admin@example.com

# Web server (nginx) ports: standard 80/443, or the alternative 8080/4443 when 80/443 are
# taken. Change them later with "sudo go-euc-set-ports standard|alternative" or the landing
# page (Maintenance > Web ports). InfluxDB 8086, Portainer 9443 and SSH 22 do not change.
# APPLIANCE_HTTP_PORT=80
# APPLIANCE_HTTPS_PORT=443

# Public host name clients are given (Telegraf configs, Proxmox Metric Server, Grafana links),
# with or without a Let's Encrypt certificate, e.g. a DNS name or a reverse proxy in front of
# the appliance. Optional ":port" (default: the web port above). Change later with
# "sudo go-euc-set-hostname <name>[:<port>]|--clear" or Maintenance > Public host name.
# APPLIANCE_PUBLIC_HOSTNAME=goeuc.example.com
