# GO-EUC appliance test settings. Copy to ~/.goeuc-test/nutanix.env (or $GOEUC_TEST_DIR/nutanix.env)
# and restrict it:  mkdir -p ~/.goeuc-test && chmod 700 ~/.goeuc-test && chmod 600 ~/.goeuc-test/nutanix.env
# This file holds secrets: never commit the real one. Values are shell-style (quote special characters).

# Prism Element (cluster VIP or a CVM IP) and an account that can create images and VMs.
PRISM_HOST=10.0.0.5
PRISM_USER=admin
PRISM_PASSWORD='<prism-password>'

# Account the appliance's Nutanix collector uses (a Viewer-role account is enough).
PRISM_VIEWER_USER=viewer
PRISM_VIEWER_PASSWORD='<viewer-password>'
# Optional: Prism Element address for the collector (defaults to PRISM_HOST).
# NUTANIX_COLLECTOR_ADDRESS=10.0.0.6

# AHV network (name as shown in Prism) and storage container for the image.
NTNX_NETWORK='VM Network'
NTNX_CONTAINER='default-container'

# Static network settings for the test appliance (the console wizard's answers).
APPLIANCE_IP_CIDR=192.168.102.130/24
APPLIANCE_GATEWAY=192.168.102.1
APPLIANCE_DNS=192.168.102.1
